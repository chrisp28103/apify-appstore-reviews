{
  "actorSpecification": 1,
  "fields": {},
  "views": {
    "overview": {
      "title": "Reviews",
      "description": "One row per review. Each row has the app name, developer and average stars.",
      "transformation": {
        "fields": ["appName", "appDeveloper", "appAverageRating", "country", "rating", "title", "text", "author", "date", "version", "appId"]
      },
      "display": {
        "component": "table",
        "properties": {
          "appName": { "label": "App", "format": "text" },
          "appDeveloper": { "label": "Developer", "format": "text" },
          "appAverageRating": { "label": "App average stars", "format": "number" },
          "country": { "label": "Country", "format": "text" },
          "rating": { "label": "Stars", "format": "number" },
          "title": { "label": "Review title", "format": "text" },
          "text": { "label": "Review text", "format": "text" },
          "author": { "label": "Author", "format": "text" },
          "date": { "label": "Date", "format": "date" },
          "version": { "label": "App version", "format": "text" },
          "appId": { "label": "App id", "format": "text" }
        }
      }
    },
    "apps": {
      "title": "Apps",
      "description": "App metadata rows. Only filled in metadata-only runs: turn on 'Include app metadata' and set Max reviews to 0.",
      "transformation": {
        "fields": ["name", "country", "developer", "averageRating", "ratingCount", "version", "price", "currency", "genres", "url", "appId"]
      },
      "display": {
        "component": "table",
        "properties": {
          "name": { "label": "App", "format": "text" },
          "country": { "label": "Country", "format": "text" },
          "developer": { "label": "Developer", "format": "text" },
          "averageRating": { "label": "Average stars", "format": "number" },
          "ratingCount": { "label": "Ratings", "format": "number" },
          "version": { "label": "Version", "format": "text" },
          "price": { "label": "Price", "format": "number" },
          "currency": { "label": "Currency", "format": "text" },
          "genres": { "label": "Genres", "format": "array" },
          "url": { "label": "Store link", "format": "link" },
          "appId": { "label": "App id", "format": "text" }
        }
      }
    }
  }
}
